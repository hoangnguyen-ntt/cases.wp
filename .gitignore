# Ignore everything in the repository root, but explicitly allow README and the theme/proto folders
/*
!/.gitignore
!/README.md
!/README.MD
!/readme.md
!/router.php

# Allow prototype and starter theme directories
!/proto/
!/wp-content/themes/starter-theme/

# WordPress core folders (keep themes and necessary files)
/wp-admin/
/wp-includes/
/wp-content/

# Ignore runtime and IDE files
.env
.env.local
.DS_Store
.vscode/

# Composer / PHP
vendor/
composer.lock

# Logs
/logs/
*.log

# Build artifacts
/dist/
/build/

# Ignore local database dumps
*.sql
*.sqlite

# Keep gitignore itself
!.gitignore
/.env
.DS_Store
