# Ignore everything in the repository root, but explicitly allow README and the theme/proto folders
/*
!/.gitignore
!/README.md
!/README.MD
!/readme.md

# Allow prototype and starter theme directories
!/proto/
!/proto/**
!/wp-content/
!/wp-content/themes/
!/wp-content/themes/starter-theme/
!/wp-content/themes/starter-theme/**

# WordPress core folders (keep themes and necessary files)
/wp-admin/
/wp-includes/

# Ignore plugin folders and uploads
/wp-content/plugins/
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/cache/

# Ignore runtime and IDE files
.env
.env.local
.DS_Store
.vscode/
node_modules/
npm-debug.log
yarn-error.log

# Composer / PHP
vendor/
composer.lock

# Logs
/logs/
*.log

# Build artifacts
/dist/
/build/

# Ignore local database dumps
*.sql
*.sqlite

# Keep gitignore itself
!.gitignore
/.env
/vendor/
/node_modules/
wp-content/uploads/
wp-content/database/*.sqlite
wp-content/database/*.db
.DS_Store
